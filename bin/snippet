#!/usr/bin/env php
<?php

declare(strict_types=1);

use Snippet\Application;
use Snippet\Cli\ErrorReporter;
use Snippet\Preview\PreviewServer;

$engineRoot = dirname(__DIR__);
$workspace = getcwd();
if ($workspace === false) {
    fwrite(STDERR, "Unable to resolve the current workspace.\n");
    exit(1);
}

require $engineRoot . '/vendor/autoload.php';

/** @var list<string> $arguments */
$arguments = $_SERVER['argv'];
$stdout = new SplFileObject('php://stdout', 'w');
$stderr = new SplFileObject('php://stderr', 'w');
$errorReporter = new ErrorReporter(
    decorated: getenv('NO_COLOR') === false
        && getenv('TERM') !== 'dumb'
        && stream_isatty(STDERR),
);

$status = new Application($workspace, errorReporter: $errorReporter)->run(
    $arguments,
    $stdout,
    $stderr,
);

if ($status !== PreviewServer::RESTART_EXIT_CODE) {
    exit($status);
}

if (!function_exists('pcntl_exec')) {
    $errorReporter->failure($stderr, 'Preview restart', 'PCNTL is unavailable; restart preview manually to load the runtime changes.');
    exit(1);
}

$stdout->fwrite("Restarting preview with fresh runtime code.\n");
pcntl_exec(PHP_BINARY, [
    $engineRoot . '/bin/snippet',
    ...array_slice($arguments, 1),
]);
$errorReporter->failure($stderr, 'Preview restart', 'Unable to restart preview with fresh runtime code.');
exit(1);
