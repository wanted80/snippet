{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "wanted80/snippet",
    "description": "A small personal static publishing system.",
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^8.5",
        "ext-date": "*",
        "ext-filter": "*",
        "ext-hash": "*",
        "ext-mbstring": "*",
        "ext-pcre": "*",
        "ext-random": "*",
        "ext-tokenizer": "*",
        "ext-uri": "*"
    },
    "require-dev": {
        "ext-json": "*",
        "ext-pcntl": "*",
        "ext-pcov": "*",
        "ext-posix": "*",
        "laravel/pint": "^1.30.5",
        "pestphp/pest": "^5.1.3",
        "pestphp/pest-plugin-agent": "^5.0",
        "pestphp/pest-plugin-evals": "^5.0.3",
        "pestphp/pest-plugin-phpstan": "^5.2.0",
        "pestphp/pest-plugin-rector": "^5.0.4",
        "pestphp/pest-plugin-type-coverage": "^5.0.2",
        "phpstan/extension-installer": "^1.4.3",
        "phpstan/phpstan": "^2.2.13",
        "phpstan/phpstan-deprecation-rules": "^2.0.4",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "rector/rector": "^2.6.6"
    },
    "autoload": {
        "psr-4": {
            "Snippet\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Snippet\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "app:content:validate": "sh docker/demo/validate.sh",
        "app:test": "php -d pcov.enabled=1 -d pcov.directory=src vendor/bin/pest",
        "app:test:assets": "node --test tests/Frontend/*.test.mjs",
        "app:test:coverage": "php -d pcov.enabled=1 -d pcov.directory=src vendor/bin/pest --no-tia --coverage --exactly=100",
        "app:test:types": "php -d memory_limit=512M vendor/bin/pest --no-tia --type-coverage --min=100",
        "app:test:mutations": [
            "Composer\\Config::disableProcessTimeout",
            "sh docker/quality/mutations.sh"
        ],
        "app:analyse": "phpstan analyse --no-progress --memory-limit=512M",
        "app:audit": "composer audit --locked",
        "app:lint": [
            "pint --parallel --test",
            "rector process --dry-run"
        ],
        "app:fix": [
            "rector process",
            "pint --parallel"
        ],
        "app:check": [
            "@app:test:coverage",
            "@app:test:types",
            "@app:lint",
            "@app:analyse",
            "@app:content:validate"
        ]
    },
    "scripts-descriptions": {
        "app:content:validate": "Compose and validate the demo site",
        "app:test": "Run the Pest test suite",
        "app:test:assets": "Run dependency-free JavaScript behavior tests",
        "app:test:coverage": "Run tests with exact 100% line coverage",
        "app:test:types": "Run tests with 100% type coverage",
        "app:test:mutations": "Run the complete test suite with a 100% mutation score",
        "app:analyse": "Run PHPStan static analysis",
        "app:audit": "Audit locked dependencies against Composer security advisories",
        "app:lint": "Check formatting and automated refactoring",
        "app:fix": "Apply automated refactoring and formatting",
        "app:check": "Run the complete application quality gate"
    },
    "config": {
        "bump-after-update": true,
        "optimize-autoloader": true,
        "platform": {
            "php": "8.5"
        },
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
