{
    "name": "Snippet",
    "dockerComposeFile": [
        "../compose.yaml",
        "../compose.dev.yaml"
    ],
    "service": "app",
    "runServices": [
        "app"
    ],
    "remoteUser": "snippet",
    "updateRemoteUserUID": true,
    "workspaceFolder": "/app",
    "shutdownAction": "stopCompose",
    "mounts": [
        "source=${localEnv:HOME}${localEnv:USERPROFILE}/.codex,target=/mnt/snippet-host-codex,type=bind"
    ],
    "postCreateCommand": ".devcontainer/post-create.sh",
    "customizations": {
        "vscode": {
            "extensions": [
                "bmewburn.vscode-intelephense-client",
                "eamodio.gitlens"
            ]
        }
    }
}
